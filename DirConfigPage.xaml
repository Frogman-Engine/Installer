<Page x:Class="Installer.DirConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Installer"
      mc:Ignorable="d" 
      d:DesignWidth="1280" d:DesignHeight="720"
      Title="Frogman Engine GDK Installer" 
      Width="1280" Height="720">


    <Grid Background="White">
        <TextBlock TextWrapping="Wrap" Text="Set Installation Path" FontSize="32" FontWeight="Bold" Margin="20,100,20,415"/>


        <StackPanel Orientation="Horizontal" Margin="20,-300,0,0">
            <TextBox x:Name="InstallationPathTextBox" FontSize="16" VerticalAlignment="Center" Height="25" Width="400" />
            <Button Content="Browse..." FontSize="16" VerticalAlignment="Center" Click="OnClickBrowseButton" Height="25" Width="100" Margin="10,0,0,0" />
        </StackPanel>


        <Expander Header="GDK Versions" VerticalAlignment="Top" HorizontalAlignment="Left" Width="700" Margin="22,240,0,0" Expanded="OnClickDisplaySdkVersionList">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ListBox x:Name="SdkVersionListBox" SelectionChanged="OnSelectSdkVersion">
                </ListBox>
            </ScrollViewer>
        </Expander>


    </Grid>
</Page>
