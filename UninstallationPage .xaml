<Page x:Class="Installer.UninstallationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Installer"
      mc:Ignorable="d" 
      d:DesignWidth="1280" d:DesignHeight="720"
      Title="Frogman Engine GDK Uinstaller" 
      Width="1280" Height="720">


    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <TextBlock TextWrapping="Wrap" Text="Uninstalling the Frogman Engine GDK...!" FontSize="32" FontWeight="Bold" Margin="20,100,20,415" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        
        <ProgressBar x:Name="UninstallationProgressBar" Minimum="0" Maximum="100" Height="20" VerticalAlignment="Top" Margin="22,170,558,0">
            <ProgressBar.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FEAC5E" Offset="0.0" />
                    <GradientStop Color="#C779D0" Offset="0.5" />
                    <GradientStop Color="#4BC0C8" Offset="1.0" />
                </LinearGradientBrush>
            </ProgressBar.Foreground>
        </ProgressBar>

        <TextBlock x:Name="Percent" TextAlignment="Center" Height="17" FontWeight="Bold" Foreground="Green"  Background="LightGray" Margin="727,170,520,530"/>
        
        <TextBox x:Name="CommandLogTextBox" Height="390" VerticalAlignment="Top" Margin="22,195,558,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Grid>
    
    
</Page>
