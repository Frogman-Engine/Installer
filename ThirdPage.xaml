<Page x:Class="Installer.ThirdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Installer"
      mc:Ignorable="d" 
      d:DesignWidth="1280" d:DesignHeight="720"
      Title="Frogman Engine SDK Installer" 
      Width="1280" Height="720">


    <Grid Background="White">
        <TextBlock TextWrapping="Wrap" Text="Installing the Frogman Engine SDK...!" FontSize="32" FontWeight="Bold" Margin="20,100,20,415"/>

        <ProgressBar x:Name="InstallationProgressBar" Minimum="0" Maximum="100" Height="20" VerticalAlignment="Top" Margin="22,170,558,0"/>
        <TextBlock x:Name="Percent" TextAlignment="Center" Height="17" Background="LightGray" Margin="727,170,520,530"/>

        <TextBox x:Name="CommandLogTextBox" Height="390" VerticalAlignment="Top" Margin="22,195,558,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
