<Page x:Class="Installer.Uninstaller"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Installer"
      mc:Ignorable="d" 
      d:DesignWidth="1280" d:DesignHeight="720"
      Title="Frogman Engine GDK Uninstaller" 
      Width="1280" Height="720">


    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <TextBlock TextWrapping="Wrap" Text="Uninstall Frogman Engine GDK" FontSize="32" FontWeight="Bold" Margin="20,100,20,415" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock TextWrapping="Wrap" Text="One or more versions of Frogman Engine GDKs have been found. " FontSize="16" FontWeight="Bold" Margin="22,155,20,360" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>


        <Expander Header="GDK Versions" VerticalAlignment="Top" HorizontalAlignment="Left" Width="700" Margin="22,240,0,0" Expanded="OnClickDisplayGdkVersionList" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ListBox x:Name="SdkVersionListBox" SelectionChanged="OnSelectSdkVersion">
                </ListBox>
            </ScrollViewer>
        </Expander>


    </Grid>
</Page>
